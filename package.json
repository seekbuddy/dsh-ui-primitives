{
  "name": "dsh-ui-primitives",
  "version": "0.2.0",
  "description": "Independent React component kit matching the DeepSeek Harness web UI design system (--dsw-* tokens, light/dark themes). Design source: @deepseek-ai/dsh-client-ui-primitives + dsh-client-ui-theme (MIT).",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "react",
    "ui",
    "design-system",
    "tokens"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/types/blocks.d.ts",
      "import": "./dist/blocks.js"
    },
    "./markdown": {
      "types": "./dist/types/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./icons": {
      "types": "./dist/types/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./theme": {
      "types": "./dist/types/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./theme/bootstrap": {
      "types": "./dist/types/theme-bootstrap.d.ts",
      "import": "./dist/theme-bootstrap.js"
    },
    "./tokens.css": {
      "types": "./dist/tokens.css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./katex.css": {
      "types": "./dist/katex.css.d.ts",
      "default": "./dist/katex.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://resetsix.github.io/dsh-ui-primitives/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resetsix/dsh-ui-primitives.git"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-theme-tests.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:react18": "node scripts/test-fixture.mjs react18",
    "test:next16": "node scripts/test-fixture.mjs next16",
    "verify": "npm run typecheck && npm run test:unit && npm run build && npm run test:package && npm run test:react18 && npm run test:next16 && npm run demo:build && npm run build:site",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "build:site": "node scripts/build-site.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@shikijs/langs": "^4.3.1",
    "@types/mdast": "^4.0.4",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.29.0",
    "marked": "^15.0.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
